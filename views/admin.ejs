                        <span class="text-truncate me-2 small text-muted"><%= fileUrl.split('/').pop() %></span>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-info"
                          onclick="copyToClipboard('<%= fileUrl %>')"
                          title="URL'yi Kopyala"
                        >
                          <i class="bi bi-copy"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Mesaj Silme
    function deleteMsg(id) {
      if (!confirm('Bu mesajı kalıcı olarak silmek istediğinize emin misiniz?')) return;
      fetch(`/admin/messages/${id}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
          if (data.ok) {
            const card = document.getElementById(`msg-card-${id}`);
            if (card) {
              card.style.opacity = '0';
              card.style.transform = 'scale(0.9)';
              setTimeout(() => card.remove(), 300);
            }
          } else {
            alert('Hata: ' + (data.error || 'Silinemedi'));
          }
        })
        .catch(err => alert('Ağ hatası oluştu'));
    }

    // Proje Silme
    function deleteProjectItem(id) {
      if (!confirm('Bu projeyi kalıcı olarak silmek istediğinize emin misiniz?')) return;
      fetch(`/admin/projects/${id}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' }
      })
        .then(res => res.json())
        .then(data => {
          if (data.ok) {
            const card = document.getElementById(`proj-card-${id}`);
            if (card) card.remove();
          } else {
            alert('Hata: ' + (data.error || 'Silinemedi'));
          }
        })
        .catch(err => alert('Ağ hatası oluştu'));
    }

    // Proje Düzenleme Modalını Doldur
    function openEditProject(project) {
      document.getElementById('editProjectForm').action = `/admin/projects/edit/${project.id}`;
      document.getElementById('edit_p_name').value = project.name || '';
      document.getElementById('edit_p_badge').value = project.featuredBadge || '';
      document.getElementById('edit_p_tagline').value = project.tagline || '';
      document.getElementById('edit_p_tags').value = (project.tags || []).join(', ');
      document.getElementById('edit_p_summary').value = project.problemSolution || '';
      document.getElementById('edit_p_role').value = project.role || '';
      document.getElementById('edit_p_roledesc').value = project.roleDescription || '';
      document.getElementById('edit_p_tech').value = (project.techStack || []).join(', ');
      document.getElementById('edit_p_github').value = project.githubUrl || '';
      document.getElementById('edit_p_live').value = project.liveUrl || '';

      const modal = new bootstrap.Modal(document.getElementById('editProjectModal'));
      modal.show();
    }

    // Sertifika Silme
    function deleteCertItem(id) {
      if (!confirm('Bu sertifikayı silmek istediğinize emin misiniz?')) return;
      fetch(`/admin/certificates/${id}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' }
      })
        .then(res => res.json())
        .then(data => {
          if (data.ok) {
            const card = document.getElementById(`cert-card-${id}`);
            if (card) card.remove();
          } else {
            alert('Hata: ' + (data.error || 'Silinemedi'));
          }
        })
        .catch(err => alert('Ağ hatası oluştu'));
    }

    // Sertifika Düzenleme Modalını Doldur
    function openEditCert(cert) {
      document.getElementById('editCertForm').action = `/admin/certificates/edit/${cert.id}`;
      document.getElementById('edit_c_title').value = cert.title || '';
      document.getElementById('edit_c_issuer').value = cert.issuer || '';
      document.getElementById('edit_c_desc').value = cert.description || '';
      document.getElementById('edit_c_image').value = cert.imageUrl || '';
      document.getElementById('edit_c_verify').value = cert.verifyUrl || '';

      const modal = new bootstrap.Modal(document.getElementById('editCertModal'));
      modal.show();
    }

    // URL Kopyalama
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        alert('Kopyalandı: ' + text);
      }).catch(err => {
        prompt('Bağlantıyı kopyalayın:', text);
      });
    }
  </script>
</body>
</html>
