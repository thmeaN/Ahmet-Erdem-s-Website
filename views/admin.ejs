<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yönetim Paneli | Ahmet Erdem Öztürk</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --bg: #0f172a;
      --card-bg: #1e293b;
      --card-border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --input-bg: #0f172a;
      --input-border: #334155;
      --accent: #06b6d4;
    }

    * {
      box-sizing: border-box;
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      margin: 0;
      padding-bottom: 60px;
    }

    /* Topbar */
    .admin-navbar {
      background: rgba(30, 41, 59, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 14px 0;
    }

    .admin-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 1.15rem;
      color: white;
      text-decoration: none;
    }

    .admin-brand span {
      background: linear-gradient(135deg, #a5b4fc, #38bdf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Tabs Styling */
    .admin-tabs-nav {
      background: var(--card-bg);
      border-radius: 14px;
      padding: 6px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      border: 1px solid var(--card-border);
      margin-bottom: 25px;
    }

    .admin-tab-btn {
      background: transparent;
      color: var(--text-muted);
      border: none;
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .admin-tab-btn:hover {
      color: white;
      background: rgba(255, 255, 255, 0.05);
    }

    .admin-tab-btn.active {
      background: var(--primary);
      color: white;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }

    .tab-badge {
      background: rgba(255, 255, 255, 0.2);
      padding: 2px 7px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    /* Panels & Cards */
    .admin-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 26px;
      margin-bottom: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .admin-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--card-border);
    }

    .admin-card-header h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Form Controls */
    .form-label {
      color: #cbd5e1;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .form-control, .form-select {
      background-color: var(--input-bg) !important;
      border: 1px solid var(--input-border) !important;
      color: var(--text) !important;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 0.92rem;
      transition: all 0.2s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--accent) !important;
      box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2) !important;
    }

    .form-text {
      color: var(--text-muted);
      font-size: 0.78rem;
      margin-top: 4px;
    }

    /* Buttons */
    .btn-save-primary {
      background: linear-gradient(135deg, #4f46e5, #3b82f6);
      color: white;
      border: none;
      padding: 12px 26px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
    }

    .btn-save-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(79, 70, 229, 0.45);
      color: white;
    }

    .btn-custom-outline {
      background: transparent;
      border: 1px solid var(--card-border);
      color: var(--text);
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }

    .btn-custom-outline:hover {
      background: rgba(255, 255, 255, 0.08);
      color: white;
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* Message Cards */
    .msg-item-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 16px;
      transition: all 0.2s ease;
    }

    .msg-item-card:hover {
      border-color: rgba(99, 102, 241, 0.4);
      background: rgba(15, 23, 42, 0.9);
    }

    .msg-author {
      font-weight: 700;
      color: #f1f5f9;
      font-size: 1rem;
    }

    .msg-email {
      color: var(--accent);
      font-size: 0.85rem;
    }

    .msg-body {
      background: rgba(0, 0, 0, 0.2);
      border-radius: 8px;
      padding: 12px 14px;
      margin: 12px 0;
      color: #cbd5e1;
      font-size: 0.92rem;
      line-height: 1.6;
      white-space: pre-wrap;
    }

    /* Item Grid (Projects, Certs, Media) */
    .items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }

    .item-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
    }

    .item-box:hover {
      border-color: rgba(6, 182, 212, 0.4);
      transform: translateY(-2px);
    }

    .media-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .media-thumb {
      width: 100%;
      height: 140px;
      object-fit: cover;
      background: #0b1120;
    }

    .media-info {
      padding: 10px;
      font-size: 0.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .stat-mini-pill {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 12px 18px;
      text-align: center;
    }

    .stat-mini-pill .num {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--accent);
    }

    .stat-mini-pill .lbl {
      font-size: 0.78rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <header class="admin-navbar">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
      <a href="/admin" class="admin-brand">
        <i class="bi bi-shield-lock-fill text-primary" style="font-size: 1.4rem;"></i>
        <div>Ahmet Erdem <span>CMS & Yönetim</span></div>
      </a>
      <div class="nav-actions">
        <a href="/" target="_blank" class="btn-custom-outline">
          <i class="bi bi-box-arrow-up-right"></i> Siteyi Gör
        </a>
        <a href="/logout" class="btn btn-outline-danger btn-sm" style="border-radius: 8px;">
          <i class="bi bi-box-arrow-right"></i> Çıkış
        </a>
      </div>
    </div>
  </header>

  <main class="container-fluid px-4 mt-4">

    <!-- BİLDİRİMLER -->
    <% if (notification && notification.success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; border-radius: 10px;">
        <i class="bi bi-check-circle-fill me-2"></i> <%= notification.success %>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (notification && notification.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; border-radius: 10px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= notification.error %>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- TABS NAVIGATION -->
    <nav class="admin-tabs-nav">
      <a href="/admin?tab=messages" class="admin-tab-btn <%= activeTab === 'messages' ? 'active' : '' %>">
        <i class="bi bi-envelope-fill"></i> Mesajlar
        <span class="tab-badge"><%= stats.totalMessages %></span>
      </a>
      <a href="/admin?tab=profile" class="admin-tab-btn <%= activeTab === 'profile' ? 'active' : '' %>">
        <i class="bi bi-person-badge-fill"></i> Profil & Ana Sayfa
      </a>
      <a href="/admin?tab=about" class="admin-tab-btn <%= activeTab === 'about' ? 'active' : '' %>">
        <i class="bi bi-info-circle-fill"></i> Hakkımda & Yetkinlikler
      </a>
      <a href="/admin?tab=projects" class="admin-tab-btn <%= activeTab === 'projects' ? 'active' : '' %>">
        <i class="bi bi-code-slash"></i> Projelerim
        <span class="tab-badge"><%= (siteData.projects || []).length %></span>
      </a>
      <a href="/admin?tab=certificates" class="admin-tab-btn <%= activeTab === 'certificates' ? 'active' : '' %>">
        <i class="bi bi-patch-check-fill"></i> Sertifikalarım
        <span class="tab-badge"><%= (siteData.certificates || []).length %></span>
      </a>
      <a href="/admin?tab=leadership" class="admin-tab-btn <%= activeTab === 'leadership' ? 'active' : '' %>">
        <i class="bi bi-mortarboard-fill"></i> Liderlik & A.T.A.K.
      </a>
      <a href="/admin?tab=media" class="admin-tab-btn <%= activeTab === 'media' ? 'active' : '' %>">
        <i class="bi bi-images"></i> Medya & Dosya Yükle
      </a>
    </nav>

    <!-- ============================================================== -->
    <!-- TAB 1: GELEN MESAJLAR                                          -->
    <!-- ============================================================== -->
    <% if (activeTab === 'messages') { %>
      <div class="admin-card">
        <div class="admin-card-header">
          <h2><i class="bi bi-inbox-fill text-primary"></i> Gelen İletişim Mesajları</h2>
          <div class="d-flex gap-2">
            <div class="stat-mini-pill">
              <div class="num"><%= stats.totalMessages %></div>
              <div class="lbl">Toplam</div>
            </div>
            <div class="stat-mini-pill">
              <div class="num"><%= stats.todayCount %></div>
              <div class="lbl">Bugün</div>
            </div>
            <div class="stat-mini-pill">
              <div class="num"><%= stats.uniqueEmails %></div>
              <div class="lbl">Farklı Kişi</div>
            </div>
          </div>
        </div>

        <!-- Arama Formu -->
        <form method="GET" action="/admin" class="row g-2 mb-4">
          <input type="hidden" name="tab" value="messages" />
          <div class="col-md-10">
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="🔍 İsim, e-posta veya mesaj metninde ara..."
              value="<%= searchQuery %>"
            />
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-bold">Ara</button>
            <% if (searchQuery) { %>
              <a href="/admin?tab=messages" class="btn btn-secondary">Temizle</a>
            <% } %>
          </div>
        </form>

        <% if (messages.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-mailbox2" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Mesaj Bulunamadı</h4>
            <p>Arama kriterine uygun veya yeni gelen bir mesaj yok.</p>
          </div>
        <% } else { %>
          <div class="row">
            <% messages.forEach(msg => { %>
              <div class="col-lg-6" id="msg-card-<%= msg.id %>">
                <div class="msg-item-card">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <div class="msg-author"><%= msg.name %></div>
                      <div class="msg-email"><i class="bi bi-envelope"></i> <%= msg.email %></div>
                    </div>
                    <span class="badge bg-dark border border-secondary text-light">
                      <%= new Date(msg.createdAt).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                  </div>

                  <div class="msg-body"><%= msg.message %></div>

                  <div class="d-flex justify-content-between align-items-center pt-2">
                    <a
                      href="mailto:<%= msg.email %>?subject=<%= encodeURIComponent('Re: ' + msg.name) %>"
                      class="btn btn-sm btn-outline-success"
                    >
                      <i class="bi bi-reply-fill"></i> E-posta ile Yanıtla
                    </a>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-danger"
                      onclick="deleteMsg('<%= msg.id %>')"
                    >
                      <i class="bi bi-trash3-fill"></i> Sil
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- ============================================================== -->
    <!-- TAB 2: PROFİL & ANA SAYFA                                      -->
    <!-- ============================================================== -->
    <% if (activeTab === 'profile') { %>
      <div class="admin-card">
        <div class="admin-card-header">
          <h2><i class="bi bi-person-lines-fill text-primary"></i> Profil & Ana Sayfa Ayarları</h2>
          <span class="text-muted small">Ana sayfadaki hero, biyografi ve sosyal bağlantıları yönetin</span>
        </div>

        <form method="POST" action="/admin/profile">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Ad Soyad</label>
              <input type="text" name="name" class="form-control" value="<%= siteData.profile.name %>" required />
            </div>

            <div class="col-md-6">
              <label class="form-label">Durum Rozeti (Örn: Bilgisayar Mühendisliği)</label>
              <input type="text" name="statusBadge" class="form-control" value="<%= siteData.profile.statusBadge %>" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Konum / Şehir</label>
              <input type="text" name="location" class="form-control" value="<%= siteData.profile.location %>" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Uzmanlık Başlığı (Örn: AI & Yazılım)</label>
              <input type="text" name="tagline" class="form-control" value="<%= siteData.profile.tagline %>" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Profil Fotoğrafı URL / Yolu</label>
              <input type="text" name="avatar" class="form-control" value="<%= siteData.profile.avatar %>" />
              <div class="form-text">Medya sekmesinden yüklediğiniz bir görsel yolunu yapıştırabilirsiniz.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Karşılama Rozeti (Hero Greeting)</label>
              <input type="text" name="heroGreeting" class="form-control" value="<%= siteData.profile.heroGreeting %>" />
            </div>

            <div class="col-12">
              <label class="form-label">Daktilo (Typewriter) Metni (HTML destekler: &lt;br /&gt;)</label>
              <input type="text" name="typewriterText" class="form-control" value="<%= siteData.profile.typewriterText %>" />
            </div>

            <div class="col-12">
              <label class="form-label">Kısa Hero Biyografisi (HTML &lt;b&gt; etiketleri destekler)</label>
              <textarea name="bioLead" class="form-control" rows="3"><%= siteData.profile.bioLead %></textarea>
            </div>
          </div>

          <h4 class="mt-4 mb-3 border-bottom border-secondary pb-2">🌐 Sosyal Medya Bağlantıları</h4>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label"><i class="bi bi-linkedin"></i> LinkedIn URL</label>
              <input type="url" name="linkedin" class="form-control" value="<%= siteData.profile.socials.linkedin %>" />
            </div>
            <div class="col-md-4">
              <label class="form-label"><i class="bi bi-github"></i> GitHub URL</label>
              <input type="url" name="github" class="form-control" value="<%= siteData.profile.socials.github %>" />
            </div>
            <div class="col-md-4">
              <label class="form-label"><i class="bi bi-bar-chart-fill"></i> Kaggle URL</label>
              <input type="url" name="kaggle" class="form-control" value="<%= siteData.profile.socials.kaggle %>" />
            </div>
            <div class="col-md-4">
              <label class="form-label"><i class="bi bi-instagram"></i> Instagram URL</label>
              <input type="url" name="instagram" class="form-control" value="<%= siteData.profile.socials.instagram %>" />
            </div>
            <div class="col-md-4">
              <label class="form-label"><i class="bi bi-discord"></i> Discord Linki</label>
              <input type="url" name="discord" class="form-control" value="<%= siteData.profile.socials.discord %>" />
            </div>
            <div class="col-md-4">
              <label class="form-label"><i class="bi bi-telegram"></i> Telegram Linki</label>
              <input type="url" name="telegram" class="form-control" value="<%= siteData.profile.socials.telegram %>" />
            </div>
          </div>

          <h4 class="mt-4 mb-3 border-bottom border-secondary pb-2">📌 Ana Sayfa Öne Çıkan Bento Kartları</h4>
          <div class="row g-3">
            <% (siteData.profile.highlights || []).forEach((card, i) => { %>
              <div class="col-md-4">
                <div class="p-3 border border-secondary rounded bg-dark">
                  <h6 class="text-info mb-2">Kart #<%= i + 1 %></h6>
                  <div class="mb-2">
                    <label class="form-label">İkon (Emoji)</label>
                    <input type="text" name="highlight_icon[]" class="form-control" value="<%= card.icon %>" />
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Rozet (Opsiyonel)</label>
                    <input type="text" name="highlight_badge[]" class="form-control" value="<%= card.badge %>" />
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Başlık</label>
                    <input type="text" name="highlight_title[]" class="form-control" value="<%= card.title %>" />
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Açıklama</label>
                    <textarea name="highlight_desc[]" class="form-control" rows="2"><%= card.description %></textarea>
                  </div>
                  <div class="row g-2">
                    <div class="col-6">
                      <label class="form-label">Link Metni</label>
                      <input type="text" name="highlight_linktext[]" class="form-control" value="<%= card.linkText %>" />
                    </div>
                    <div class="col-6">
                      <label class="form-label">Link URL</label>
                      <input type="text" name="highlight_linkurl[]" class="form-control" value="<%= card.linkUrl %>" />
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>

          <div class="mt-4 text-end">
            <button type="submit" class="btn-save-primary">
              <i class="bi bi-check2-circle"></i> Değişiklikleri Kaydet
            </button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- ============================================================== -->
    <!-- TAB 3: HAKKIMDA & YETKİNLİKLER                                 -->
    <!-- ============================================================== -->
    <% if (activeTab === 'about') { %>
      <div class="admin-card">
        <div class="admin-card-header">
          <h2><i class="bi bi-file-earmark-person-fill text-primary"></i> Hakkımda & Yetkinlikler Ayarları</h2>
          <span class="text-muted small">Biyografi metinleri, hedefler ve teknoloji kategorileri</span>
        </div>

        <form method="POST" action="/admin/about">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Üst Çip / Breadcrumb</label>
              <input type="text" name="breadcrumb" class="form-control" value="<%= siteData.about.breadcrumb %>" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Sayfa Ana Başlığı</label>
              <input type="text" name="title" class="form-control" value="<%= siteData.about.title %>" required />
            </div>
            <div class="col-md-4">
              <label class="form-label">Sayfa Alt Başlığı</label>
              <input type="text" name="subtitle" class="form-control" value="<%= siteData.about.subtitle %>" />
            </div>

            <div class="col-12">
              <label class="form-label">Biyografi Karşılama Başlığı</label>
              <input type="text" name="bioTitle" class="form-control" value="<%= siteData.about.bioTitle %>" />
            </div>

            <div class="col-12">
              <label class="form-label">Biyografi Paragrafları (Her satır ayrı bir paragraf oluşturur - HTML etiketleri kullanılabilir)</label>
