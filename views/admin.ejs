<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin - İletişim Mesajları</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 10px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px;
      text-align: center;
    }

    .header h1 {
      font-size: 2.5rem;
      margin-bottom: 10px;
    }

    .header p {
      font-size: 1.1rem;
      opacity: 0.9;
    }

    .stats {
      display: flex;
      justify-content: center;
      gap: 30px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    .stat {
      text-align: center;
    }

    .stat-number {
      font-size: 2rem;
      font-weight: bold;
    }

    .stat-label {
      font-size: 0.9rem;
      opacity: 0.8;
    }

    .content {
      padding: 30px;
    }

    .messages-grid {
      display: grid;
      gap: 20px;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    }

    .message-card {
      background: #f8f9fa;
      border-left: 5px solid #667eea;
      padding: 20px;
      border-radius: 8px;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .message-card:hover {
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      transform: translateY(-2px);
    }

    .message-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 15px;
    }

    .message-name {
      font-weight: bold;
      font-size: 1.1rem;
      color: #333;
    }

    .message-date {
      font-size: 0.85rem;
      color: #999;
      white-space: nowrap;
    }

    .message-email {
      color: #667eea;
      font-size: 0.9rem;
      margin-bottom: 12px;
      word-break: break-all;
    }

    .message-text {
      color: #555;
      line-height: 1.6;
      margin-bottom: 15px;
      max-height: 150px;
      overflow-y: auto;
    }

    .message-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 15px;
      border-top: 1px solid #ddd;
    }

    .delete-btn {
      background: #ff6b6b;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.3s ease;
    }

    .delete-btn:hover {
      background: #ff5252;
      transform: scale(1.05);
    }

    .reply-btn {
      background: #40c057;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.3s ease;
      margin-right: 10px;
    }

    .reply-btn:hover {
      background: #37b24d;
      transform: scale(1.05);
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #999;
    }

    .empty-state-icon {
      font-size: 3rem;
      margin-bottom: 20px;
    }

    .empty-state h2 {
      color: #666;
      margin-bottom: 10px;
    }

    @media (max-width: 768px) {
      .messages-grid {
        grid-template-columns: 1fr;
      }

      .header h1 {
        font-size: 1.8rem;
      }

      .stats {
        gap: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>📨 İletişim Yönetim Paneli</h1>
      <p>Gelen mesajları yönet ve yanıtla</p>
      <div class="stats">
        <div class="stat">
          <div class="stat-number"><%= stats.totalMessages %></div>
          <div class="stat-label">Toplam Mesaj</div>
        </div>
        <div class="stat">
          <div class="stat-number"><%= stats.todayCount %></div>
          <div class="stat-label">Bugün</div>
        </div>
        <div class="stat">
          <div class="stat-number"><%= stats.uniqueEmails %></div>
          <div class="stat-label">Benzersiz E-posta</div>
        </div>
      </div>
    </div>

    <div class="content">
      <!-- Arama Formu -->
      <form method="GET" action="/admin" style="margin-bottom: 30px; display: flex; gap: 10px;">
        <input type="text" name="search" placeholder="🔍 Adı, emaili veya mesajı ara..." value="<%= searchQuery %>" 
          style="flex: 1; padding: 12px 15px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem;">
        <button type="submit" style="background: #667eea; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.3s;">
          Ara
        </button>
        <% if (searchQuery) { %>
          <a href="/admin" style="background: #999; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; display: flex; align-items: center; transition: 0.3s;">
            Temizle
          </a>
        <% } %>
      </form>

      <!-- Arama Sonucu -->
      <% if (searchQuery) { %>
        <div style="background: #e8f5e9; border-left: 4px solid #40c057; padding: 12px 15px; margin-bottom: 20px; border-radius: 5px;">
          🔍 "<%= searchQuery %>" için <strong><%= count %></strong> mesaj bulundu
        </div>
      <% } %>

      <!-- Logout Butonu -->
      <div style="text-align: right; margin-bottom: 20px;">
        <a href="/logout" style="background: #ff6b6b; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-block; transition: 0.3s;">
          🚪 Çıkış Yap
        </a>
      </div>
      <% if (messages.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">📭</div>
          <h2>Henüz mesaj yok</h2>
          <p>Mesaj geldiğinde burada görünecek</p>
        </div>
      <% } else { %>
        <div class="messages-grid">
          <% messages.forEach(msg => { %>
            <div class="message-card" data-id="<%= msg.id %>">
              <div class="message-header">
                <div class="message-name"><%= msg.name %></div>
                <div class="message-date">
                  <%= new Date(msg.createdAt).toLocaleDateString('tr-TR', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  }) %>
                </div>
              </div>
              <div class="message-email">✉️ <%= msg.email %></div>
              <div class="message-text"><%= msg.message %></div>
              <div class="message-footer">
                <button class="reply-btn" onclick="openEmail('<%= msg.email %>', '<%= msg.name.replace(/'/g, "\\\\'") %>')">Cevapla</button>
                <button class="delete-btn" onclick="deleteMessage('<%= msg.id %>')">Sil</button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    function openEmail(email, name) {
      const subject = encodeURIComponent(`Re: ${name}`);
      window.location.href = `mailto:${email}?subject=${subject}`;
    }

    function deleteMessage(id) {
      if (confirm('Bu mesajı silmek istediğinize emin misiniz?')) {
        fetch(`/admin/messages/${id}`, {
          method: 'DELETE',
        })
        .then(res => res.json())
        .then(data => {
          if (data.ok) {
            const card = document.querySelector(`[data-id="${id}"]`);
            card.style.animation = 'fadeOut 0.3s ease';
            setTimeout(() => card.remove(), 300);
            
            // Sayfayı yenile
            setTimeout(() => location.reload(), 500);
          } else {
            alert('Mesaj silinemedi');
          }
        })
        .catch(err => console.error(err));
      }
    }
  </script>

  <style>
    @keyframes fadeOut {
      to {
        opacity: 0;
        transform: translateY(10px);
      }
    }
  </style>
</body>
</html>
