    <script src="script.js"></script>
    <script>
      const text = "Selam, Adım <br />Ahmet Erdem.";
      const target = document.getElementById("typewriter-text");
      let index = 0;

      function typeWriter() {
        if (index < text.length) {
          if (text.charAt(index) === '<') {
            index = text.indexOf('>', index);
          }
          
          target.innerHTML = text.substring(0, index + 1) + "<span class='cursor'>|</span>";
          index++;
          setTimeout(typeWriter, 100);
        } else {
          target.innerHTML = text + "<span class='cursor'>|</span>";
        }
      }
      
      // Sayfa yüklendiğinde daktilo efektini başlat
      window.onload = () => {
        setTimeout(typeWriter, 500);
      };

      // Yukarı Çıkar Butonu Scroll Efekti
      const scrollBtn = document.getElementById("scrollTopBtn");
      window.addEventListener("scroll", () => {
        if (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) {
          scrollBtn.classList.add("show");
        } else {
          scrollBtn.classList.remove("show");
        }
      });
      
      // Asansör ve Navigasyon Menüsü İşlemleri
      const navLinksCont = document.querySelector('.nav-links');
      const navItems = document.querySelectorAll('.nav-item');
      const elevator = document.getElementById('elevator');
      const sections = Array.from(navItems).map(item => document.querySelector(item.getAttribute('href')));

      function updateElevator() {
        if (!navLinksCont || !elevator) return;
        
        let current = 0;
        for (let i = 0; i < sections.length; i++) {
          if (sections[i]) {
            const rect = sections[i].getBoundingClientRect();
            // Sayfanın ortasını geçtiğinde aktif olsun
            if (rect.top <= window.innerHeight / 2) {
              current = i;
            }
          }
        }
        
        navItems.forEach(item => item.classList.remove('active'));
        if (navItems[current]) {
          navItems[current].classList.add('active');
          const itemRect = navItems[current].getBoundingClientRect();
          const trackRect = document.querySelector('.elevator-track').getBoundingClientRect();
          
          // Hesaplanan pozisyonu asansör ikonuna aktar (Tam merkeze hizalama)
          const itemMiddle = itemRect.top - trackRect.top + (itemRect.height / 2);
          const elevatorHeight = 26; // Sabit ikon yüksekliği olarak alabiliriz
          
          elevator.style.transform = `translateY(${itemMiddle - (elevatorHeight / 2)}px) scale(0.85)`;
        }
      }

      window.addEventListener('scroll', updateElevator);
      window.addEventListener('resize', updateElevator);
      setTimeout(updateElevator, 100);

      // Tıklandığında en üste yumuşak kayma
      scrollBtn.addEventListener("click", function(e) {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          left: 0,
          behavior: "smooth"
        });
      });
    </script>
    
