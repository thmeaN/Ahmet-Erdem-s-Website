<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('partials/head') %>
</head>
<body class="page-home">
  <%- include('partials/navbar') %>

  <main class="page-main-container">
    <!-- HERO BÖLÜMÜ -->
    <section class="hero-split-section">
      <!-- SOL: Profil Kartı -->
      <div class="hero-left-wrapper">
        <div class="profile-card-modern">
          <% if (profile.statusBadge) { %>
            <div class="profile-status-badge">
              <span class="status-dot"></span> <%= profile.statusBadge %>
            </div>
          <% } %>
          <div class="profile-avatar-frame">
            <img
              id="fotografim"
              src="<%= profile.avatar || '/Pictures/fotograf.jpg' %>"
              alt="<%= profile.name %>"
            />
          </div>
          <div class="profile-meta-row">
            <% if (profile.location) { %>
              <span class="meta-item"><i class="bi bi-geo-alt-fill"></i> <%= profile.location %></span>
            <% } %>
            <% if (profile.tagline) { %>
              <span class="meta-item"><i class="bi bi-cpu-fill"></i> <%= profile.tagline %></span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- SAĞ: Tanıtım & Butonlar -->
      <div class="hero-right-wrapper">
        <div class="greeting-chip"><%= profile.heroGreeting || '👋 Portfolyoma Hoş Geldin' %></div>
        <h1 class="hero-name-title">
          <b style="visibility: hidden; grid-area: 1 / 1;"><%- profile.typewriterText || 'Selam, Adım <br />Ahmet Erdem.' %><span style="opacity: 0;">|</span></b>
          <b id="typewriter-text" style="grid-area: 1 / 1;"></b>
        </h1>
        <p class="hero-bio-lead">
          <%- profile.bioLead %>
        </p>

        <div class="hero-actions-row">
          <a href="/projelerim" class="btn-primary-glow">
            <i class="bi bi-code-square"></i> Projelerimi İncele
          </a>
          <a href="/iletisim" class="btn-secondary-glass">
            <i class="bi bi-envelope-fill"></i> İletişime Geç
          </a>
        </div>

        <div class="hero-social-grid">
          <% if (profile.socials && profile.socials.linkedin) { %>
            <a href="<%= profile.socials.linkedin %>" target="_blank" class="social-glass-pill linkedin" title="LinkedIn">
              <i class="bi bi-linkedin"></i>
              <span>LinkedIn</span>
            </a>
          <% } %>
          <% if (profile.socials && profile.socials.github) { %>
            <a href="<%= profile.socials.github %>" target="_blank" class="social-glass-pill github" title="GitHub">
              <i class="bi bi-github"></i>
              <span>GitHub</span>
            </a>
          <% } %>
          <% if (profile.socials && profile.socials.kaggle) { %>
            <a href="<%= profile.socials.kaggle %>" target="_blank" class="social-glass-pill kaggle" title="Kaggle">
              <img src="/Pictures/kaggle%20logo.png" alt="Kaggle" />
              <span>Kaggle</span>
            </a>
          <% } %>
          <% if (profile.socials && profile.socials.instagram) { %>
            <a href="<%= profile.socials.instagram %>" target="_blank" class="social-glass-pill" title="Instagram">
              <i class="bi bi-instagram" style="color: #e1306c;"></i>
              <span>Instagram</span>
            </a>
          <% } %>
        </div>
      </div>
    </section>

    <!-- HIZLI ÖNE ÇIKANLAR (Bento Highlights) -->
    <section class="home-highlights-section">
      <div class="home-bento-grid">
        <% if (profile.highlights && profile.highlights.length > 0) { %>
          <% profile.highlights.forEach((card, index) => { %>
            <a href="<%= card.linkUrl || '#' %>" class="bento-highlight-card <%= card.badge ? 'featured-border' : '' %>">
              <div class="bento-card-icon"><%= card.icon || '📌' %></div>
              <% if (card.badge) { %>
                <div class="card-badge"><%= card.badge %></div>
              <% } %>
              <h3><%= card.title %></h3>
              <p><%= card.description %></p>
              <span class="bento-arrow-link"><%= card.linkText || 'İncele' %> <i class="bi bi-arrow-right"></i></span>
            </a>
          <% }); %>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    const text = <%- JSON.stringify(profile.typewriterText || "Selam, Adım <br />Ahmet Erdem.") %>;
    const target = document.getElementById("typewriter-text");
    let index = 0;

    function typeWriter() {
      if (index < text.length) {
        if (text.charAt(index) === '<') {
          index = text.indexOf('>', index);
        }
        target.innerHTML = text.substring(0, index + 1) + "<span class='cursor'>|</span>";
        index++;
        setTimeout(typeWriter, 85);
      } else {
        target.innerHTML = text + "<span class='cursor'>|</span>";
      }
    }
    
    window.onload = () => {
      setTimeout(typeWriter, 350);
    };
  </script>
</body>
</html>
